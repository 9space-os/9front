From 614864a8ee2ba8d7fcffca6f01efb237cea6803c Mon Sep 17 00:00:00 2001
From: Stefan Hertenberger <erde74@gmail.com>
Date: Sun, 15 Nov 2026 00:52:17 +0100
Subject: [PATCH 35/46] kbmap: the maps sorted by name

kbmap listed /sys/lib/kbmap in the order its file server reads the
directory: alphabetical from hjfs and cwfs, any order from others
(ufs serving a root from a Linux host).  It sorts the names now.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sys/src/cmd/kbmap.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/sys/src/cmd/kbmap.c b/sys/src/cmd/kbmap.c
index 940005920..cc9076f8e 100644
--- a/sys/src/cmd/kbmap.c
+++ b/sys/src/cmd/kbmap.c
@@ -60,6 +60,12 @@ estrdup(char *s)
 	return t;
 }
 
+static int
+mapcmp(void *a, void *b)
+{
+	return strcmp(((KbMap*)a)->name, ((KbMap*)b)->name);
+}
+
 void
 init(void)
 {
@@ -78,6 +84,8 @@ init(void)
 		map[i].current = 0;
 	}
 	free(pd);
+	/* by name: a directory's order is its file server's */
+	qsort(map, nmap, sizeof(KbMap), mapcmp);
 
 	close(fd);
 }
