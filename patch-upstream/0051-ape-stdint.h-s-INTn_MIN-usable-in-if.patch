From bd513faeab66f7feb3753bcd73c2a94218bd8839 Mon Sep 17 00:00:00 2001
From: Stefan Hertenberger <erde74@gmail.com>
Date: Thu, 19 Nov 2026 11:14:26 +0100
Subject: [PATCH 51/59] ape: stdint.h's INTn_MIN usable in #if

INT8_MIN to INT64_MIN were casts, which a preprocessor #if refuses;
C99 (7.18.2) wants them constant expressions usable there, and
programs test them so (libxkbcommon's state.c). Written as the most
negative values without a cast; their types are int (int8_t, int16_t
promote to it) and long long, as before.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sys/include/ape/stdint.h | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/sys/include/ape/stdint.h b/sys/include/ape/stdint.h
index f002f8f81..859413055 100644
--- a/sys/include/ape/stdint.h
+++ b/sys/include/ape/stdint.h
@@ -44,10 +44,11 @@ typedef uint64_t	uint_least64_t;
 typedef _intptr_t intptr_t;
 typedef _uintptr_t uintptr_t;
 
-#define INT8_MIN	((int8_t)0x80)
-#define INT16_MIN	((int16_t)0x8000)
-#define INT32_MIN	((int32_t)0x80000000)
-#define INT64_MIN	((int64_t)0x8000000000000000LL)
+/* constant expressions without casts (C99 7.18.2): #if takes them */
+#define INT8_MIN	(-0x7f-1)
+#define INT16_MIN	(-0x7fff-1)
+#define INT32_MIN	(-0x7fffffff-1)
+#define INT64_MIN	(-0x7fffffffffffffffLL-1)
 #define INTMAX_MIN	INT64_MIN
 
 #define UINT8_MIN	0
