From bbe82780f48c3c831d721767ac3198932fbdbd71 Mon Sep 17 00:00:00 2001
From: Stefan Hertenberger <erde74@gmail.com>
Date: Thu, 19 Nov 2026 11:14:16 +0100
Subject: [PATCH 50/59] ape: sigaddset takes every signal; sigprocmask with no
 set changes nothing

stdsigs, the signals sigaddset and sigfillset know, or'ed the signals'
numbers, not their bits: SIGHUP|...|SIGUSR2 is 15, so sigaddset refused
SIGTERM, SIGCHLD and every other signal whose bit is not in 15, and
sigfillset filled 15. Now each signal's bit, with the job-control
signals signal.h defines as well.

sigprocmask(how, nil, &old), POSIX's way to read the mask, read *set
through the nil pointer.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sys/src/ape/lib/ap/plan9/sigprocmask.c |  2 ++
 sys/src/ape/lib/ap/posix/sigset.c      | 14 +++++++++++---
 2 files changed, 13 insertions(+), 3 deletions(-)

diff --git a/sys/src/ape/lib/ap/plan9/sigprocmask.c b/sys/src/ape/lib/ap/plan9/sigprocmask.c
index 84b94f987..52f647ca5 100644
--- a/sys/src/ape/lib/ap/plan9/sigprocmask.c
+++ b/sys/src/ape/lib/ap/plan9/sigprocmask.c
@@ -9,6 +9,8 @@ sigprocmask(int how, sigset_t *set, sigset_t *oset)
 {
 	if(oset)
 		*oset = _psigblocked;
+	if(set == 0)	/* POSIX: no change, how not looked at */
+		return 0;
 	if(how==SIG_BLOCK)
 		_psigblocked |= *set;
 	else if(how==SIG_UNBLOCK)
diff --git a/sys/src/ape/lib/ap/posix/sigset.c b/sys/src/ape/lib/ap/posix/sigset.c
index 1a9ef12aa..9fe6bd656 100644
--- a/sys/src/ape/lib/ap/posix/sigset.c
+++ b/sys/src/ape/lib/ap/posix/sigset.c
@@ -6,11 +6,19 @@
  * the signal #define'd as i in signal.h is inluded.
  */
 
-static sigset_t stdsigs = SIGHUP|SIGINT|SIGQUIT|SIGILL|SIGABRT|SIGFPE|SIGKILL|
-		SIGSEGV|SIGPIPE|SIGALRM|SIGTERM|SIGUSR1|SIGUSR2;
-
 #define BITSIG(s) (2<<(s))
 
+/*
+ * the signals there are, as their bits (their numbers or'ed made 15:
+ * sigaddset refused SIGTERM, SIGCHLD and every other whose bit is not
+ * in 15)
+ */
+static sigset_t stdsigs = BITSIG(SIGHUP)|BITSIG(SIGINT)|BITSIG(SIGQUIT)|BITSIG(SIGILL)|
+		BITSIG(SIGABRT)|BITSIG(SIGFPE)|BITSIG(SIGKILL)|BITSIG(SIGSEGV)|BITSIG(SIGPIPE)|
+		BITSIG(SIGALRM)|BITSIG(SIGTERM)|BITSIG(SIGUSR1)|BITSIG(SIGUSR2)|BITSIG(SIGBUS)|
+		BITSIG(SIGCHLD)|BITSIG(SIGCONT)|BITSIG(SIGSTOP)|BITSIG(SIGTSTP)|BITSIG(SIGTTIN)|
+		BITSIG(SIGTTOU);
+
 int
 sigemptyset(sigset_t *set)
 {
