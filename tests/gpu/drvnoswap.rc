#!/bin/rc
# The GPU driver is not the pager's choice when memory runs out (gpu(4):
# each driver is noswap).  aux/virtiogpu and vkcube run; memhog takes
# memory in children half the driver's size until the pager kills one.
# The pager kills the biggest process it may kill: vkcube, a client,
# may go first; a child killed while the driver is bigger shows the
# driver was passed over.  Lines "drvnoswap: ..." for tests/gpu/run.sh.
rfork e

fn kb { awk '{print $10}' /proc/$1/status }	# procpagecount, as killbig sees it
fn drvpids { ps | awk '$NF == "virtiogpu" {print $2}' }
kn=`{wc -l </dev/kmesg}

aux/virtiogpu
bind -a '#i' /dev
d=`{drvpids}
echo drvnoswap: driver $d
WSI_PLAN9_COPY=1 /tests/vkcube --c 1000000 >/tmp/vkcube.log >[2=1] &
cpid=$apid
sleep 5
c=`{ps | awk '$NF == "vkcube" {print $2}'}
echo drvnoswap: vkcube $c
dkb=`{kb $d(1)}
ckb=`{kb $c(1)}
echo drvnoswap: kb driver $dkb vkcube $ckb
# a child half the driver
h=`{echo $dkb | awk '{h = int($1 / 2); if(h < 16) h = 16; print h}'}
echo drvnoswap: child kb $h
# for the log: the biggest other processes (those the pager passes
# over too: the host owner's noswap services, termrc's dontkill)
{for(f in /proc/[0-9]*/status) awk '{print $10, $1}' $f >[2]/dev/null} | grep -v ' (virtiogpu|vkcube)$' | sort -n | tail -3 | sed 's/^/drvnoswap: other /'
grep free /dev/swap | sed 's/^/drvnoswap: swap /'
/tests/memhog $h >/tmp/memhog.log >[2=1]
sed 's/^/drvnoswap: /' /tmp/memhog.log
sleep 2
echo drvnoswap: driver after `{drvpids}
echo drvnoswap: vkcube after `{ps | awk '$NF == "vkcube" {print $2}'}
tail -n +`{echo $kn + 1 | hoc} /dev/kmesg | grep 'Killed: Insufficient physical memory' | sed 's/^/drvnoswap: killed: /'
@{echo kill >/proc/$cpid/note} >[2]/dev/null
sleep 1
# the driver still serves gpu(4) (gputest alone would draw on the
# framebuffer it leaves behind)
grep '^device ' /shr/gpu/0/status >[2]/dev/null | sed 's/^/drvnoswap: serves /'
for(p in `{drvpids})
	@{echo kill >/proc/$p/note} >[2]/dev/null
echo drvnoswap: done
