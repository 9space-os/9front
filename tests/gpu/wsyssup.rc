#!/bin/rc
# run by wsys -x -i (tests/gpu/run.sh): wsys keeps its helpers going
# (wsys(4): window -restart, wctl helper and restart). Lines "sup: ...".
# 1. a window -restart whose program the pager kills (memhog -s, which
#    grows without bound, the biggest process): started again in the same
#    window, more than once; deleted, it is not started again.
# 2. a helper -restart that ends as the pager's kill does (its wait
#    message): started again; it ends of its own on its third run.
# 3. a helper -restart that crashes (another status): 5 runs, then given
#    up; restart to wsys' wctl starts it once more.
# 4. kbdtap across a helper's restart (reform's shortcuts' case): a key
#    reaches a window through the tap; the helper ends as the pager's kill
#    does; a key while it is gone reaches the window, not held back; after
#    its restart a key goes through the tap again.
fn wctl { echo $* >/mnt/wsys/wctl }
fn runs { if(test -e $1) wc -l <$1; if not echo 0 }
# the test's channel to the host (the MCP server) is not what is tested
for(p in `{ps | awk '$NF == "9front-mcp" {print $2}'})
	echo noswap >/proc/$p/ctl >[2]/dev/null
kn=`{wc -l </dev/kmesg}
rm -f /tmp/sup.helper /tmp/sup.crash

# 1
old=`{ls -p /mnt/wsys | grep '^[0-9]+$'}
window -restart -r 20 20 300 200 /tests/memhog -s 4096
sleep 1
w=()
for(n in `{ls -p /mnt/wsys | grep '^[0-9]+$'}) if(! ~ $n $old) w=$n
echo sup: window $w
n=0
while(test `{tail -n +`{echo $kn + 1 | hoc} /dev/kmesg | grep -c 'memhog [0-9]+: Killed: Insufficient physical memory'} -lt 2 && test $n -lt 120){ sleep 0.5; n=`{echo $n+1 | hoc} }
k=`{tail -n +`{echo $kn + 1 | hoc} /dev/kmesg | grep -c 'memhog [0-9]+: Killed: Insufficient physical memory'}
echo sup: memhog killed by the pager $k times
echo sup: window $w still `{test -e /mnt/wsys/$w && echo there || echo gone}
echo delete >/mnt/wsys/$w/wctl
sleep 3
k2=`{ps | awk '$NF == "memhog"' | wc -l}
echo sup: memhog running after the delete: $k2

# 2
echo '#!/bin/rc
echo ran >>/tmp/sup.helper
if(test `{wc -l </tmp/sup.helper} -ge 3) exit ''''
exit ''Killed: Insufficient physical memory''' >/tmp/fakekill
chmod +x /tmp/fakekill
wctl helper -restart /tmp/fakekill
n=0
while(test `{runs /tmp/sup.helper} -lt 3 && test $n -lt 40){ sleep 0.5; n=`{echo $n+1 | hoc} }
sleep 3
echo sup: helper killed for memory ran `{runs /tmp/sup.helper} times

# 3
echo '#!/bin/rc
echo ran >>/tmp/sup.crash
exit crashed' >/tmp/fakecrash
chmod +x /tmp/fakecrash
wctl helper -restart /tmp/fakecrash
n=0
while(test `{runs /tmp/sup.crash} -lt 5 && test $n -lt 60){ sleep 0.5; n=`{echo $n+1 | hoc} }
sleep 5
echo sup: crashing helper ran `{runs /tmp/sup.crash} times
wctl restart
# started once more by hand (its count of crashes anew, wsys(4)): the run
# itself, not the retries after it (1 s on)
n=0
while(test `{runs /tmp/sup.crash} -lt 6 && test $n -lt 50){ sleep 0.1; n=`{echo $n+1 | hoc} }
echo sup: after restart it ran `{runs /tmp/sup.crash} times

# 4
rm -f /tmp/sup.keys /tmp/tap.log /tmp/tap.runs /tmp/tap.die /tmp/tap.go
echo '#!/bin/rc
echo start >>/tmp/tap.runs
# its second run: the tap only once the test says go
if(test `{wc -l </tmp/tap.runs} -ge 2)
	while(! test -e /tmp/tap.go) sleep 0.1
</mnt/wsys/kbdtap tee -a /tmp/tap.log >/mnt/wsys/kbdtap &
t=$apid
while(! test -e /tmp/tap.die) sleep 0.1
rm -f /tmp/tap.die
echo kill >/proc/$t/note
echo ended >>/tmp/tap.runs
exit ''Killed: Insufficient physical memory''' >/tmp/faketap
chmod +x /tmp/faketap
wctl helper -restart /tmp/faketap
# a script: window(1) passes its command's words unquoted, a redirection
# in them would be window's own
echo '#!/bin/rc
cat >/tmp/sup.keys' >/tmp/keycat
chmod +x /tmp/keycat
window -r 320 20 700 200 /tmp/keycat
sleep 2
fn kbd { aux/kbdtype $1; aux/kbdtype '
' }
fn has { grep -s $2 $1 >[2]/dev/null }
kbd a
sleep 1
if(has /tmp/sup.keys '^a$') echo sup: key a in the window
if(has /tmp/tap.log 'ca') echo sup: key a through the tap
touch /tmp/tap.die
n=0
while(! has /tmp/tap.runs ended && test $n -lt 50){ sleep 0.1; n=`{echo $n+1 | hoc} }
kbd b
sleep 1
if(has /tmp/sup.keys '^b$') echo sup: key b in the window while the reader of the tap was gone
if(! has /tmp/tap.log 'cb') echo sup: key b not through a tap
touch /tmp/tap.go
sleep 2
kbd c
sleep 1
if(has /tmp/sup.keys '^c$') echo sup: key c in the window after the restart
if(has /tmp/tap.log 'cc') echo sup: key c through the tap again
echo sup: tap helper runs `{grep -c start /tmp/tap.runs}
echo sup: done
