#!/bin/rc
# batteryguard - when the battery is critical and no AC charges it,
# halt the file servers and power off (batteryguard(8); 9space)
rfork e
crit=5
grace=60
~ $#batterycrit 1 && crit=$batterycrit
while(~ $1 -*){
	switch($1){
	case -c
		crit=$2
		shift
	case -g
		grace=$2
		shift
	case *
		echo usage: batteryguard '[-c percent] [-g seconds]' >[1=2]
		exit usage
	}
	shift
}

# the first battery's charge (percent) and status: acpi(8), fields 1 and 12
fn battery {
	b=`{sed 1q /dev/battery >[2]/dev/null}
	pct=()
	st=()
	if(~ $#b 14){
		pct=$b(1)
		st=$b(12)
	}
}

fn low {
	! ~ $st charging idle unknown && {~ $st critical || test $pct -le $crit}
}

battery
if(~ $#pct 0)
	exit nobattery
while(){
	battery
	if(~ $#pct 1 && low){
		echo batteryguard: battery at $pct% '('$st'):' halting in $grace seconds unless AC is plugged in >[1=2]
		sleep $grace
		battery
		if(~ $#pct 1 && low){
			echo batteryguard: battery at $pct%: halting >[1=2]
			fshalt
			exit
		}
		echo batteryguard: AC plugged in, not halting >[1=2]
	}
	sleep 30
}
