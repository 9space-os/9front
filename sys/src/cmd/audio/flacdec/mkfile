</$objtype/mkfile
<../config

TARGET=flacdec

CC=pcc
CFLAGS=-I. -I../libFLAC -I../libFLAC/FLAC -D_POSIX_SOURCE -D_BSD_EXTENSION -DPlan9

%.$O: %.c
	$CC $CFLAGS -c $stem.c

# 9space: the libraries (libFLAC's ogg code: libogg) by name, not only by the headers' #pragma lib
# (gcc and gccmk do not take it)
$O.%: %.$O ../libFLAC/libFLAC.a$O ../libogg/libogg.a$O
	$CC -o $target $prereq

all:V: $O.$TARGET

clean:V:
	rm -f *.[$OS] [$OS].$TARGET

install:V: $O.$TARGET
	cp $O.$TARGET $BIN/$TARGET

test:VQ:
	# nothing
