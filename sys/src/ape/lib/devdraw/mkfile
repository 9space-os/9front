# GCC port: devdraw for gcc's APE programs (wsys serves draw(3) itself,
# ../9front-ui PLAN stage 4c): /sys/src/cmd/drawfs' devdraw.c and compat.c
# with core.c, the calls a program makes instead of drawfs' 9P
APE=/sys/src/ape
<$APE/config

LIB=/$objtype/lib/ape/libdevdraw.a

OFILES=\
	compat.$O\
	core.$O\
	devdraw.$O\

</sys/src/cmd/mksyslib

# APEGNU: -D_APE_GNU (APE's gcc headers, under -U__GNUC__) where gcc
# builds it, the tree's build and gccmk's /$objtype/mkfile; empty under
# kencc, whose pcc has APE's own types (stdint.h's gcc block takes gcc's)
CFLAGS=-c $CFLAGS -D_POSIX_SOURCE -D_PLAN9_SOURCE -D_RESEARCH_SOURCE $APEGNU -Duintptr=uintptr_t -I/sys/src/cmd/drawfs -I../9

%.$O: /sys/src/cmd/drawfs/%.c
	$CC $CFLAGS /sys/src/cmd/drawfs/$stem.c
