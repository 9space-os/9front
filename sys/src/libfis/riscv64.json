[
    {
        "Name": "klibfis-riscv64",
        "Cflags": [
            "-march=rv64imac_zicsr_zifencei",
            "-mabi=lp64",
            "-mcmodel=medany",
            "-mno-relax",
            "-fsigned-char",
            "-ffixed-x26",
            "-ffixed-x27",
            "-fno-pic",
            "-fno-builtin",
            "-ffreestanding",
            "-nostdinc",
            "-fplan9-extensions",
            "-fno-asynchronous-unwind-tables",
            "-fno-stack-protector",
            "-fno-omit-frame-pointer",
            "-fno-zero-initialized-in-bss",
            "-Os",
            "-gdwarf-2"
        ],
        "SourceFiles": [
            "fis.c"
        ],
        "Include": [
            "/$ARCH/kernel.$TOOLSET.json"
        ]
    }
]
