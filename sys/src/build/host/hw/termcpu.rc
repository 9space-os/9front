#!/bin/rc
# termcpu (sys/src/build/host/hw/pxe.sh puts it in a test machine's root as
# /rc/bin/termcpu; for testing, not part of the system): this terminal as
# an auth server and cpu server of its own, for drawterm (and rcpu) from
# another machine:
#
#	drawterm -h ADDR -a ADDR -u glenda
#
# The keys are in $home/lib: nvram (the machine's: its authid $user, an
# authdom, the password; auth/wrkey asks once) and keys (keyfs's, with
# $user's key: auth/changeuser asks once, the same password).  A factotum
# of its own (-S: its keys from that nvram) serves authsrv on tcp!*!567 and
# rcpu on tcp!*!17019 in a name space of their own; they run until killed.
# Nothing is asked again once the files are there: termrc.local then
# starts it at boot.
rfork ne
if(! ~ $#* 0){
	echo usage: termcpu >[1=2]
	exit usage
}
lib=$home/lib
nvram=$lib/nvram
mkdir -p $lib
if(! test -s $nvram){
	touch $nvram
	chmod 600 $nvram
	echo 'termcpu: the machine''s key: authid '$user', an authdom (9space), no secstore key, a password'
	auth/wrkey || exit wrkey
}
auth/factotum -S -n || exit factotum
# not made beforehand: keyfs takes an empty file for one of DES keys, and
# dp9ik (drawterm) needs the AES ones it makes in a file it creates
auth/keyfs -m /mnt/keys $lib/keys || exit keyfs
if(! test -d /mnt/keys/$user){
	echo 'termcpu: '$user'''s key: the same password'
	auth/changeuser $user || exit changeuser
}
aux/listen1 -t 'tcp!*!567' /rc/bin/service.auth/tcp567 &
aux/listen1 -t 'tcp!*!17019' /rc/bin/service/tcp17019 &
ip=`{grep -h '^[0-9]+\.' /net/ipifc/*/local | awk '{print $1}' | grep -v '^127' | sed 1q}
echo 'termcpu: authsrv and rcpu listening; from another machine:'
echo '	drawterm -h '$ip' -a '$ip' -u '$user
