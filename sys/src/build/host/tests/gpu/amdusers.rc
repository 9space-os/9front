#!/bin/rc
# gpu(4) for several users (aux/amdgpu): the hostowner grants none the
# GPU ("user none": the share gpu.none, none's); none uses the GPU
# through /shr/gpu.none/0 (amdctxtest: contexts, objects, their
# segments attached, submissions; radvtest: RADV), and may not: walk
# the hostowner's share, the hostowner's context, the driver's ctl,
# show a picture (scanout).
fn amdg { for(d in /shr/gpu/[0-9]*) if(grep -s '^device amd' $d/status >[2]/dev/null) echo $d }	# the AMD card's entry (gpu(4): named for its #G/n)
bind -a '#i' /dev
bind -a '#v' /dev
aux/amdgpu $* >/tmp/amd.log >[2=1]
sleep 2
ls -ld '#σc/gpu'
if(echo user none >`{amdg}^/ctl)
	echo passed user none granted
if not
	echo FAIL user none
ls -ld '#σc/gpu.none' '#σc/gpu.grant.none'
# a context of the hostowner's, held open meanwhile
{sleep 60} <>`{amdg}^/clone &
sleep 1
ctx=`{ls `{amdg}^/ctx | sed 's,.*/,,'}
echo hostowner context: $ctx
ls -l `{amdg}^/ctx/$ctx
auth/none rc /tests/amdusersnone.rc $ctx
grep 'WARN|error|fault|segment' /tmp/amd.log
echo TESTEND
