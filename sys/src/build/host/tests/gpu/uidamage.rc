#!/bin/rc
# run by wsys -g -x -i with WSYSDEBUG=damage (sys/src/build/host/tests/gpu/run.sh): ui's damage
# reaches wsys. ui (ui(4)) in a 500x400 window, a label and a progress bar;
# then only the bar's value changes, 400 times. ui draws only what changed
# (Masonry's damage) and presents it as the damage of the frame (wgpu's
# present_with_damage, VK_KHR_incremental_present; Mesa's plan9 WSI hands it
# to wsys), so wsys composes about the bar, not the window: its "damage:"
# lines (every 120 frames) say so. Lines "uidamage: ...".
if(! test -x /tests/ui){
	echo uidamage: no /tests/ui
	exit
}
window -r 100 100 600 500 'rc -c ''/tests/ui -s uidmg >/tmp/uidmg.log >[2=1]'''
n=0
while(! test -e /srv/uidmg && test $n -lt 100){ sleep 0.1; n=`{echo $n+1 | hoc} }
mount /srv/uidmg /mnt/ui || { echo uidamage: no /srv/uidmg: `{cat /tmp/uidmg.log}; exit }
echo 'title uidamage
new t label
set t text only the bar below changes
new p progress
set p value 0' >/mnt/ui/ctl
n=0
while(~ `{cat /mnt/ui/nodes/p/rect} () && test $n -lt 300){ sleep 0.1; n=`{echo $n+1 | hoc} }
echo uidamage: renderer `{cat /mnt/ui/renderer}
echo uidamage: bar `{cat /mnt/ui/nodes/p/rect}
sleep 1
for(i in `{seq 1 400}){
	echo set p value `{echo $i % 100 / 100 | hoc} >/mnt/ui/ctl
	sleep 0.03
}
sleep 1
grep '^wsi plan9: [^ ]*: ' /tmp/uidmg.log | sed 's/^/uidamage: /'
unmount /mnt/ui
echo uidamage: done
