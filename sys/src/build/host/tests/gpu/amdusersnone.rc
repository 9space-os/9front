#!/bin/rc
# amdusers.rc's part as none: amdusersnone.rc ctx (the hostowner's context)
fn amdg { for(d in /shr/gpu.none/[0-9]*) if(grep -s '^device amd' $d/status >[2]/dev/null) echo $d }	# none's entry for the AMD card
fn noamdg { a=`{amdg}; ~ $#a 0 }
ctx=$1
if(test -e /shr/gpu/[0-9]*/status)
	echo FAIL none walked the hostowner share
if not
	echo passed none may not walk /shr/gpu
if(noamdg){
	echo FAIL none has no AMD entry in /shr/gpu.none
	exit
}
echo passed none has its own share /shr/gpu.none
if(cat `{amdg}^/ctx/$ctx/ctl >/dev/null >[2]/dev/null)
	echo FAIL none read the hostowner context
if not
	echo passed none may not read the hostowner context
if(@{echo 0 0 >`{amdg}^/ctx/$ctx/submit} >[2]/dev/null)
	echo FAIL none submitted to the hostowner context
if not
	echo passed none may not submit to the hostowner context
if(@{echo user none >`{amdg}^/ctl} >[2]/dev/null)
	echo FAIL none wrote the driver ctl
if not
	echo passed none may not write the driver ctl
if(@{echo 1280x720 >`{amdg}^/outputs/HDMI-A-1/mode} >[2]/dev/null)
	echo FAIL none set a mode
if not
	echo passed none may not set a mode
x=`{@{read; echo scanout 0 >[1=0]} <>`{amdg}^/clone >[2=1]}
if(~ $"x *permission*)
	echo passed none may not scan out: $x
if not
	echo FAIL none scanout: $x
/tests/amdctxtest `{amdg} | grep 'passed|FAIL|done in'
# RADV, 40 s at most; libdrm9's trace of the last steps if it hangs
DRM9DEBUG=1 /tests/radvtest >/tmp/radv.none >[2=1] &
r=$apid
for(t in `{seq 40})
	if(test -e /proc/$r/status)
		sleep 1
if(test -e /proc/$r/status){
	echo FAIL radvtest as none hung: its last lines
	tail -25 /tmp/radv.none
	echo kill >/proc/$r/ctl
}
if not
	grep 'passed|FAIL' /tmp/radv.none
grep '^pci' `{amdg}^/status
/tests/vulkaninfo --summary >[2=1] | grep 'deviceName|driverInfo'
