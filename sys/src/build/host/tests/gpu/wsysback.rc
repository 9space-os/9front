#!/bin/rc
# run by wsys -x -i (sys/src/build/host/tests/gpu/run.sh, WSYSDEBUG=comp, its log /tmp/wsys.log):
# the GPU's driver killed while wsys composes on the GPU, then started
# again (as killdrv.rc): wsys composes on the processor meanwhile and on
# the GPU again once the driver is back; vktri's frames then GPU buffers
# composed there, its pixels in the screen as composed. A vktri that runs
# across the restart (VKTRI_AGAIN) meets the lost device and goes on with a
# new instance and device, its frames composed again. Lines "back: ...".
fn drvpids { ps | awk '$NF == "virtiogpu" {print $2}' }
fn waitexit { # log
	n=0
	while(! grep -s '^wsysvk: exit' $1 && test $n -lt 600){ sleep 0.1; n=`{echo $n+1 | hoc} }
}
fn waitlog { # pattern tenths
	n=0
	while(! grep -s $1 /tmp/wsys.log && test $n -lt $2){ sleep 0.1; n=`{echo $n+1 | hoc} }
	grep -s $1 /tmp/wsys.log
}
rm -f /tmp/wba.log /tmp/wbb.log
window -r 20 20 500 380 /tests/wsysvktri /tmp/wba.log comp
waitexit /tmp/wba.log
sed 's/^/back: before: /' /tmp/wba.log
# a name space made before the restart (rfork n now): it must see the
# new driver all the same (the drivers are in shr(3)'s share gpu)
rm -f /tmp/oldns.go /tmp/oldns.out
@{
	rfork n
	while(! test -e /tmp/oldns.go)
		sleep 0.2
	if(grep -s '^device' /shr/gpu/0/status)
		echo back: an old name space sees the new driver >/tmp/oldns.out
	if not
		echo back: an old name space sees no driver >/tmp/oldns.out
} &
# a client across the restart: VKTRI_AGAIN makes all of it anew on the
# device lost (window(1) gives wsys' environment: the variable in a script)
rm -f /tmp/wbl.log
echo '#!/bin/rc
VKTRI_AGAIN=1 exec /tests/wsysvktri $*' >/tmp/vkagain
chmod +x /tmp/vkagain
window -r 520 20 900 300 /tmp/vkagain /tmp/wbl.log comp 30
n=0
while(! grep -s '^ok swapchain' /tmp/wbl.log && test $n -lt 100){ sleep 0.1; n=`{echo $n+1 | hoc} }
# as the pager does: a kill, no note handler runs
for(p in `{drvpids})
	@{echo kill >/proc/$p/note} >[2]/dev/null
# a frame to compose (a window of wsys' own): the GPU's thread meets the
# lost device only when it draws (venus: VN_DEBUG=lost, Mesa 0045)
window -r 600 400 900 600 rc
if(waitlog 'composes no longer' 300) echo back: fell back to the processor
if not echo back: no fallback
sleep 2
aux/virtiogpu >[2]/dev/null
echo back: driver again `{drvpids}
if(waitlog 'the GPU composes again' 700) echo back: the GPU composes again
if not echo back: the GPU composes not again
touch /tmp/oldns.go
n=0
while(! test -e /tmp/oldns.out && test $n -lt 50){ sleep 0.1; n=`{echo $n+1 | hoc} }
cat /tmp/oldns.out
window -r 20 20 500 380 /tests/wsysvktri /tmp/wbb.log comp
waitexit /tmp/wbb.log
sed 's/^/back: after: /' /tmp/wbb.log
waitexit /tmp/wbl.log
grep -e '^ok device lost' -e '^ok on after' -e '^ok [0-9]+ frames' -e '^FAIL' -e '^vktri:' -e '^wsysvk: exit' /tmp/wbl.log | sed 's/^/back: across: /'
echo back: done
