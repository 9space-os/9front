From 58614bfb8963b1636ab0a455d16eaad23a786a6a Mon Sep 17 00:00:00 2001
From: Stefan Hertenberger <erde74@gmail.com>
Date: Thu, 26 Nov 2026 16:18:35 +0100
Subject: [PATCH] ape: _dirfstat's second try with room for the stat's count

The size a short stat reply gives (its leading 16 bits) excludes those
two bytes; _dirstat asks again with BIT16SZ+nd, _dirfstat with nd only,
two bytes short, so it failed again. fstat failed for every file whose
stat is longer than the first buffer (STATFIXLEN+64: a name of more than
about 45 bytes with a user named glenda): gcc's cc1 said such a file did
not exist (Mesa's intel_nir_lower_non_uniform_barycentric_at_sample.c).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sys/src/ape/lib/ap/plan9/dirstat.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/sys/src/ape/lib/ap/plan9/dirstat.c b/sys/src/ape/lib/ap/plan9/dirstat.c
index f054b4f6e..a6f1471c0 100644
--- a/sys/src/ape/lib/ap/plan9/dirstat.c
+++ b/sys/src/ape/lib/ap/plan9/dirstat.c
@@ -63,11 +63,11 @@ _dirfstat(int fd)
 
 	nd = DIRSIZE;
 	for(i=0; i<2; i++){	/* should work by the second try */
-		d = malloc(sizeof(Dir) + nd);
+		d = malloc(sizeof(Dir) + BIT16SZ + nd);
 		if(d == nil)
 			return nil;
 		buf = (uchar*)&d[1];
-		n = _FSTAT(fd, buf, nd);
+		n = _FSTAT(fd, buf, BIT16SZ + nd);
 		if(n < BIT16SZ){
 			free(d);
 			return nil;
@@ -77,7 +77,7 @@ _dirfstat(int fd)
 			_convM2D(buf, n, d, (char*)&d[1]);
 			return d;
 		}
-		/* else sizeof(Dir)+nd is plenty */
+		/* else sizeof(Dir)+BIT16SZ+nd is plenty */
 		free(d);
 	}
 	return nil;
-- 
