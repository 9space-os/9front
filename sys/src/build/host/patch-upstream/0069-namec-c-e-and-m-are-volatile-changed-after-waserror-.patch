From 8636b607076cb7ccc07b606bed64aabfb0b0c3e6 Mon Sep 17 00:00:00 2001
From: Stefan Hertenberger <erde74@gmail.com>
Date: Fri, 27 Nov 2026 09:37:57 +0100
Subject: [PATCH] namec: c, e and m are volatile (changed after waserror, used
 by its handler)

After error()'s longjmp (gotolabel) a local that changed after its
waserror() (setlabel) is indeterminate unless it is volatile (C11
7.13.2.1, as for setjmp; 0066 for other places).  In namec:

- c: walk, domount and cunique replace it after the waserror, the
  handler closes it.  A compiler that keeps c in a register (passing &c
  does not stop it when it sees that walk and domount do not keep the
  address) hands the handler c as it was at waserror, up->dot or
  up->slash: closed once more and freed while still in use, and the
  real one leaked.  Found with clang (a riscv64 kernel: walk with
  c->path nil under memory pressure).
- e: parsename and walk fill it (e.name, e.elems, e.off, e.nerror), the
  handler frees them and reads e.nerror for the error message.
- m: findmount sets it in the create, whose failure puts it.

walk, domount and findmount take a Chan *volatile* and Mhead *volatile*
(domount a Path *volatile* too), growparse and parsename an Elemlist
volatile*, walk's nerror a volatile int*: the other callers' plain
pointers convert to them.  This also ends two places where namec's
volatile locals already lost their qualifier: &path to domount's
Path** and &cnew to findmount's Chan**.  parsename copies the name
through its own local (kstrdup takes a char**).

9front built with its own compilers has not shown it; the code no
longer depends on what a compiler does with these locals.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sys/src/9/port/chan.c    | 30 ++++++++++++++++++++----------
 sys/src/9/port/portfns.h |  4 ++--
 2 files changed, 22 insertions(+), 12 deletions(-)

diff --git a/sys/src/9/port/chan.c b/sys/src/9/port/chan.c
index 1ced1c96e..de49d31f8 100644
--- a/sys/src/9/port/chan.c
+++ b/sys/src/9/port/chan.c
@@ -875,7 +875,7 @@ cclone(Chan *c)
 
 /* also used by sysfile.c:/^mountfix */
 int
-findmount(Chan **cp, Mhead **mp, int type, int dev, Qid qid)
+findmount(Chan *volatile *cp, Mhead *volatile *mp, int type, int dev, Qid qid)
 {
 	Chan *to;
 	Pgrp *pg;
@@ -910,7 +910,7 @@ findmount(Chan **cp, Mhead **mp, int type, int dev, Qid qid)
  * Calls findmount but also updates path.
  */
 static int
-domount(Chan **cp, Mhead **mp, Path **path)
+domount(Chan *volatile *cp, Mhead *volatile *mp, Path *volatile *path)
 {
 	Chan **lc, *from;
 	Path *p;
@@ -978,7 +978,7 @@ ewalk(Chan *c, Chan *nc, char **name, int nname)
  * *nerror is the number of names to display in an error message.
  */
 int
-walk(Chan **cp, char **names, int nnames, int nomount, int *nerror)
+walk(Chan *volatile *cp, char **names, int nnames, int nomount, volatile int *nerror)
 {
 	int dev, didmount, dotdot, i, n, nhave, ntry, type;
 	Chan *c, *nc, *mtpt;
@@ -1182,7 +1182,7 @@ saveregisters(void)
 }
 
 static void
-growparse(Elemlist *e)
+growparse(Elemlist volatile *e)
 {
 	char **new;
 	int *inew;
@@ -1210,12 +1210,13 @@ growparse(Elemlist *e)
  * rather than a directory.
  */
 static void
-parsename(char *aname, Elemlist *e)
+parsename(char *aname, Elemlist volatile *e)
 {
 	char *name, *slash;
 
-	kstrdup(&e->name, aname);
-	name = e->name;
+	name = nil;
+	kstrdup(&name, aname);
+	e->name = name;
 	e->nelems = 0;
 	e->elems = nil;
 	e->off = smalloc(sizeof(int));
@@ -1308,12 +1309,21 @@ Chan*
 namec(char *aname, int amode, int omode, ulong perm)
 {
 	int len, n, t, nomount;
-	Chan *c;
+	/*
+	 * c, e and m change after the waserror below (walk, domount,
+	 * cunique, parsename, growparse, findmount) and its handler or
+	 * the failed create use them: volatile, else they are
+	 * indeterminate there (as after longjmp, C11 7.13.2.1); a
+	 * compiler that keeps one in a register hands back its value at
+	 * waserror time.  Hence the pointers to volatile walk, domount,
+	 * findmount, parsename and growparse take.
+	 */
+	Chan *volatile c;
 	Chan *volatile cnew;
 	Path *volatile path;
-	Elemlist e;
+	Elemlist volatile e;
 	Rune r;
-	Mhead *m;
+	Mhead *volatile m;
 	char *err;
 	char *name;
 
diff --git a/sys/src/9/port/portfns.h b/sys/src/9/port/portfns.h
index d67be5411..c0d8a4be3 100644
--- a/sys/src/9/port/portfns.h
+++ b/sys/src/9/port/portfns.h
@@ -122,7 +122,7 @@ int		fault(uintptr, uintptr, int);
 void		faultnote(char*, char*, uintptr);
 void		fdclose(int, int);
 Chan*		fdtochan(int, int, int, int);
-int		findmount(Chan**, Mhead**, int, int, Qid);
+int		findmount(Chan *volatile*, Mhead *volatile*, int, int, Qid);
 void		flushmmu(void);
 void		forceclosefgrp(void);
 void		forkchild(Proc*, Ureg*);
@@ -412,7 +412,7 @@ char*		validnamedup(char*, int);
 void		validstat(uchar*, int);
 void*		vmemchr(void*, int, ulong);
 Proc*		wakeup(Rendez*);
-int		walk(Chan**, char**, int, int, int*);
+int		walk(Chan *volatile*, char**, int, int, volatile int*);
 void		wlock(RWLock*);
 void		wunlock(RWLock*);
 void*		xalloc(ulong);
-- 
2.56.1

