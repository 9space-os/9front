From 82d36b52da85c35d3807625923627004753df79a Mon Sep 17 00:00:00 2001
From: Stefan Hertenberger <erde74@gmail.com>
Date: Wed, 18 Nov 2026 18:19:22 +0100
Subject: [PATCH 48/59] kernel: name the sources instead of "stolen from":
 ethervgbe's register layout follows FreeBSD's vge(4) (if_vgereg.h, Bill
 Paul's BSD notice kept in full); omap and mt7688 fpi.c come from Plan 9 from
 Bell Labs' ARM kernels, after an original by ark (Plan 9 Foundation, 9front
 authors; MIT)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sys/src/9/mt7688/fpi.c   |  4 +++-
 sys/src/9/omap/fpi.c     |  4 +++-
 sys/src/9/pc/ethervgbe.c | 36 +++++++++++++++++++++++++++++++++++-
 3 files changed, 41 insertions(+), 3 deletions(-)

diff --git a/sys/src/9/mt7688/fpi.c b/sys/src/9/mt7688/fpi.c
index f213d05e8..b16dfee7c 100644
--- a/sys/src/9/mt7688/fpi.c
+++ b/sys/src/9/mt7688/fpi.c
@@ -1,6 +1,8 @@
 /*
  * Floating Point Interpreter.
- * shamelessly stolen from an original by ark.
+ * From Plan 9 from Bell Labs' ARM kernels, after an original by ark.
+ * Copyright © 2021 Plan 9 Foundation, Copyright © 20XX 9front authors;
+ * MIT, /lib/legal/mit.
  *
  * NB: the Internal arguments to fpisub and fpidiv are reversed from
  * what you might naively expect: they compute y-x and y/x, respectively.
diff --git a/sys/src/9/omap/fpi.c b/sys/src/9/omap/fpi.c
index 2c1f0070c..e12d951bc 100644
--- a/sys/src/9/omap/fpi.c
+++ b/sys/src/9/omap/fpi.c
@@ -1,6 +1,8 @@
 /*
  * Floating Point Interpreter.
- * shamelessly stolen from an original by ark.
+ * From Plan 9 from Bell Labs' ARM kernels, after an original by ark.
+ * Copyright © 2021 Plan 9 Foundation, Copyright © 20XX 9front authors;
+ * MIT, /lib/legal/mit.
  */
 #include "../omap/fpi.h"
 
diff --git a/sys/src/9/pc/ethervgbe.c b/sys/src/9/pc/ethervgbe.c
index 03c61b613..4b2a3d59a 100644
--- a/sys/src/9/pc/ethervgbe.c
+++ b/sys/src/9/pc/ethervgbe.c
@@ -1,6 +1,40 @@
