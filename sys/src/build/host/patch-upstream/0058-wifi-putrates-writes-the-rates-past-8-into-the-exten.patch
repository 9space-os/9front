From 1ed2d9a8400536514ae31bea760c012588716973 Mon Sep 17 00:00:00 2001
From: Stefan Hertenberger <erde74@gmail.com>
Date: Thu, 19 Nov 2026 11:16:22 +0100
Subject: [PATCH 58/59] wifi: putrates writes the rates past 8 into the
 extended element, not all of them again

With more than 8 rates putrates cut the supported rates element to 8
and then wrote all n rates again into the extended supported rates
element (50), whose length said n: the first 8 twice, and the frame
(probe and association requests) n bytes longer than its rates. The
extended element now holds the rates after the 8 supported ones, the
basic rates first in both, as before.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sys/src/9/port/wifi.c | 59 +++++++++++++++----------------------------
 1 file changed, 20 insertions(+), 39 deletions(-)

diff --git a/sys/src/9/port/wifi.c b/sys/src/9/port/wifi.c
index 8232686b8..efeec8573 100644
--- a/sys/src/9/port/wifi.c
+++ b/sys/src/9/port/wifi.c
@@ -248,55 +248,36 @@ wifitxfail(Wifi *wifi, Block *b)
 static uchar*
 putrates(uchar *p, uchar *rates, ulong valid, ulong basic)
 {
-	int n, i, j;
+	uchar r[32];
+	int n, i, m;
 
+	/*
+	 * the basic rates first; the first 8 in the supported rates
+	 * element, the others in the extended supported rates element
+	 */
 	valid |= basic;
-
-	for(i = n = 0; i < 32 && rates[i] != 0; i++)
-		if(valid & (1UL<<i))
-			n++;
-
-	valid &= ~basic;
+	n = 0;
+	for(i = 0; i < 32 && rates[i] != 0; i++)
+		if(basic & (1UL<<i))
+			r[n++] = rates[i] | 0x80;
+	for(i = 0; i < 32 && rates[i] != 0; i++)
+		if((valid & ~basic) & (1UL<<i))
+			r[n++] = rates[i] & 0x7f;
 
 	if(n > 0){
 		/* supported rates */
+		m = n > 8 ? 8 : n;
 		*p++ = 1;
-		*p++ = n;
-		for(i = j = 0; i < 32 && j < n; i++){
-			if(basic & (1UL<<i)){
-				*p++ = rates[i] | 0x80;
-				j++;
-			}
-		}
-		for(i = 0; i < 32 && j < n; i++){
-			if(valid & (1UL<<i)){
-				*p++ = rates[i] & 0x7f;
-				j++;
-			}
-		}
+		*p++ = m;
+		memmove(p, r, m);
+		p += m;
 	}
-
 	if(n > 8){
-		/* truncate supported rates element */
-		p -= n;
-		p[-1] = 8;
-		p += 8;
-
 		/* extended supported rates */
 		*p++ = 50;
-		*p++ = n;
-		for(i = j = 0; i < 32 && j < n; i++){
-			if(basic & (1UL<<i)){
-				*p++ = rates[i] | 0x80;
-				j++;
-			}
-		}
-		for(i = 0; i < 32 && j < n; i++){
-			if(valid & (1UL<<i)){
-				*p++ = rates[i] & 0x7f;
-				j++;
-			}
-		}
+		*p++ = n - 8;
+		memmove(p, r + 8, n - 8);
+		p += n - 8;
 	}
 
 	return p;
-- 
