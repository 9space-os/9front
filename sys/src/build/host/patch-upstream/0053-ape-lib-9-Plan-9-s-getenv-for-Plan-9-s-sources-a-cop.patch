From 16a18662d0508f44d13a4c34325519c9ae69a94b Mon Sep 17 00:00:00 2001
From: Stefan Hertenberger <erde74@gmail.com>
Date: Thu, 19 Nov 2026 11:14:53 +0100
Subject: [PATCH 53/59] ape/lib/9: Plan 9's getenv for Plan 9's sources, a copy
 the caller frees

libdraw built for APE (newwindow.c, scroll.c) frees what getenv
returns, as Plan 9's getenv gives a malloc'd copy; APE's getenv gives
the string of the program's environment, which then was freed and used
again. ape/lib/9's libc.h now maps getenv to _getenv9, Plan 9's
semantics: the /env file read at the call, a copy of its own, a list's
NULs as blanks.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sys/src/ape/lib/9/getenv.c | 52 ++++++++++++++++++++++++++++++++++++++
 sys/src/ape/lib/9/libc.h   |  4 +++
 sys/src/ape/lib/9/mkfile   |  1 +
 3 files changed, 57 insertions(+)
 create mode 100644 sys/src/ape/lib/9/getenv.c

diff --git a/sys/src/ape/lib/9/getenv.c b/sys/src/ape/lib/9/getenv.c
new file mode 100644
index 000000000..1605388a5
--- /dev/null
+++ b/sys/src/ape/lib/9/getenv.c
@@ -0,0 +1,52 @@
+#include <stdlib.h>
+#include <string.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <stdio.h>
+
+/*
+ * getenv as Plan 9's libc has it, for Plan 9's sources built
+ * under APE (libc.h here defines getenv to it): the /env file read now (not
+ * the environment of the program's start), a copy of its own that the
+ * caller frees (newwindow.c and scroll.c of libdraw free it: APE's getenv
+ * gave its environment's string, freed and then used again); the NULs
+ * between a list's elements as blanks.
+ */
+char*
+_getenv9(char *name)
+{
+	char path[128], *s, *p;
+	int f, n, r;
+
+	if(name[0] == '\0' || strcmp(name, ".") == 0 || strcmp(name, "..") == 0
+	|| strchr(name, '/') != NULL || strlen(name) >= sizeof path - 6)
+		return NULL;
+	snprintf(path, sizeof path, "/env/%s", name);
+	if((f = open(path, O_RDONLY)) < 0)
+		return NULL;
+	n = 0;
+	s = NULL;
+	for(;;){
+		if((p = realloc(s, n+128+1)) == NULL){
+			free(s);
+			close(f);
+			return NULL;
+		}
+		s = p;
+		if((r = read(f, s+n, 128)) <= 0)
+			break;
+		n += r;
+	}
+	close(f);
+	if(r < 0){
+		free(s);
+		return NULL;
+	}
+	while(n > 0 && s[n-1] == '\0')
+		n--;
+	s[n] = '\0';
+	while(--n >= 0)
+		if(s[n] == '\0')
+			s[n] = ' ';
+	return s;
+}
diff --git a/sys/src/ape/lib/9/libc.h b/sys/src/ape/lib/9/libc.h
index 6f6642e5f..356e9b043 100644
--- a/sys/src/ape/lib/9/libc.h
+++ b/sys/src/ape/lib/9/libc.h
@@ -24,6 +24,10 @@
 
 #define	nelem(x)	(sizeof(x)/sizeof((x)[0]))
 
+/* Plan 9's getenv (getenv.c: /env read now, a copy the caller frees) */
+#define getenv _getenv9
+extern	char*	_getenv9(char*);
+
 typedef
 struct Qid
 {
diff --git a/sys/src/ape/lib/9/mkfile b/sys/src/ape/lib/9/mkfile
index d5bee17d9..04ed1d269 100644
--- a/sys/src/ape/lib/9/mkfile
+++ b/sys/src/ape/lib/9/mkfile
@@ -30,6 +30,7 @@ OFILES=\
 	u64.$O\
 	unmount.$O\
 	fd2path.$O\
+	getenv.$O\
 
 </sys/src/cmd/mksyslib
 
