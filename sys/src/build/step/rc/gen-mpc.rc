#!/bin/rc
# gen-mpc.sh: the C 9front's mkfiles make from .mp files with mpc
# (libsec/port/%.c, libauthsrv/%.mpc); the system's mpc
. $PLAN9/sys/src/build/step/rc/lib.rc
cd $PLAN9/sys/src/libsec/port
for(f in *.mp){
	c=`{basename $f .mp}^.c
	# mpc into a file first: in a pipeline its failure would not stop
	# this script, and update would keep a truncated file
	mpc $f >$TMP/mpc || die mpc $f
	{
		echo '#include "os.h"'
		echo '#include <mp.h>'
		cat $TMP/mpc
	} | update $c
	echo libsec/port/$c
}
cd $PLAN9/sys/src/libauthsrv
for(f in *.mp){
	m=`{basename $f .mp}^.mpc
	mpc $f >$TMP/mpc || die mpc $f
	update $m <$TMP/mpc
	echo libauthsrv/$m
}
exit ''
