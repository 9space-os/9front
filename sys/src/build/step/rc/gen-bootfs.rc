#!/bin/rc
# gen-bootfs.sh: the kernel's boot program and bootfs ($CONF.bootfs.paq),
# as boot/bootmkfile makes them, from this tree's programs
#	gen-bootfs.rc [conf [kernel dir]]	(default pc64; amd64 and 386 only)
. $PLAN9/sys/src/build/step/rc/lib.rc
CONF=$1
~ $#CONF 0 && CONF=pc64
d=$2
~ $#d 0 && d=$CONF
KDIR=$PLAN9/sys/src/9/$d
objtype=`{sed -n 's/^objtype=//p' $KDIR/mkfile}
switch($objtype){
case amd64
	O=6
	ARCHFLAGS=-mcmodel'='small
case 386
	O=8
	ARCHFLAGS=(-m32 '-march=pentium' -mno-sse)
case *
	die 'objtype='$objtype not done
}
# boot: boot.$O: ../boot/boot.c
$CC '-std=gnu17' -fno-asm -ffreestanding -nostdinc -fno-builtin -fplan9-extensions \
	-fno-omit-frame-pointer -fno-stack-protector -fno-pie $ARCHFLAGS -fcommon \
	-I$PLAN9/$objtype/include -I$PLAN9/sys/include -I$PLAN9/sys/src/9/boot \
	-c -o $TMP/boot.o $PLAN9/sys/src/9/boot/boot.c || die cc boot
$LD -o $KDIR/boot --entry'='_main -z noseparate-code -z 'max-page-size=0x1000' \
	-T $PLAN9/$objtype/plan9.ld $TMP/boot.o $PLAN9/$objtype/lib.gcc/libc.a $RT || die ld boot

# the protos, as BOOTFSPROTOS in boot/bootmkfile ($OBJ: the
# configuration's devices, ../port/mkdevlist: names with .$O)
cd $KDIR
OBJ=`{rc ../port/mkdevlist $CONF | sed 's/\.'$O'$//'}
PROTOS=()
for(i in $CONF.bootfs.proto bootfs.proto ../boot/bootfs.proto)
	if(~ $#PROTOS 0 && test -r $i)
		PROTOS=$i
if(~ devfs $OBJ || ~ devsd $OBJ || ~ devusb $OBJ)
	PROTOS=($PROTOS ../boot/disk.proto)
for(j in ../boot/*.proto)
	if(~ `{basename $j .proto} $OBJ)
		PROTOS=($PROTOS $j)
echo protos: $PROTOS
mkdir -p $TMP/$CONF.bootfs
# (its output alone through grep: a pipeline's status would be grep's too)
disk/mkfs -s $PLAN9 -d $TMP/$CONF.bootfs $PROTOS >$TMP/mkfs.out >[2=1] || {
	cat $TMP/mkfs.out
	die mkfs
}
grep -v 'lib/firmware' $TMP/mkfs.out
for(f in `{du -a $TMP/$CONF.bootfs | awk '{print $2}'})
	# the ELF programs (rc scripts and data stay as they are)
	if(test -f $f && file -m $f | grep -s 'x-elf-executable')
		$STRIP $f || die strip $f
# a new image only when what goes into it changes (names, modes,
# contents): mkpaqfs records the times, every image differs (build.exe -D)
sum=`{
	@{
		cd $TMP/$CONF.bootfs
		for(f in `{du -a . | awk '{print $2}' | sort}){
			echo $f `{ls -ld $f | awk '{print $1}'}
			if(test -f $f)
				sha1sum <$f
		}
	} | sha1sum
}
old=()
test -f $KDIR/$CONF.bootfs.sum && old=`{cat $KDIR/$CONF.bootfs.sum}
if(test -f $KDIR/$CONF.bootfs.paq && ~ $"old $"sum)
	echo $CONF.bootfs.paq: unchanged
if not{
	mkpaqfs -9 -b 65536 -o $KDIR/$CONF.bootfs.paq $TMP/$CONF.bootfs || die mkpaqfs
	echo $sum >$KDIR/$CONF.bootfs.sum
}
ls -l $KDIR/boot $KDIR/$CONF.bootfs.paq
exit ''
