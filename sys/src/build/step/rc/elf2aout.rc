#!/bin/rc
# elf2aout.py: the a.out kernel from the ELF kernel, by the build tool
# (sys/src/cmd/build/elf2aout.go): the tree's build.exe where build-self.sh
# made one, else the installed /$cputype/bin/build
if(test -x $PLAN9/sys/src/cmd/build/build.exe)
	exec $PLAN9/sys/src/cmd/build/build.exe -elf2aout $*
exec /$cputype/bin/build -elf2aout $*
