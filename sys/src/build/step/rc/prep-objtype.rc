#!/bin/rc
# prep-objtype.sh: the install directories the manifests expect, and the
# compiler's runtime library /$objtype/lib.gcc/$CCRT (gcc's libgcc.a,
# clang's libclang_rt.builtins.a; lib.rc), the one the compiler links
. $PLAN9/sys/src/build/step/rc/lib.rc
cd $PLAN9
mkdir -p $objtype/bin/aux $objtype/lib.gcc
switch($objtype){
case 386 arm64 amd64
	# only when it differs: every program links it (build.exe -D)
	f=`{$CC -print-libgcc-file-name}
	test -f $f || die no $CCRT for $objtype: $f
	if(! cmp -s $f $objtype/lib.gcc/$CCRT)
		cp $f $objtype/lib.gcc/$CCRT || die $CCRT
}
# POSIX's names of libraries whose functions are all in libap: empty archives
mkdir -p $objtype/lib.gcc/ape
for(l in m pthread rt dl)
	if(! test -f $objtype/lib.gcc/ape/lib$l.a)
		echo '!<arch>' > $objtype/lib.gcc/ape/lib$l.a
exit ''
