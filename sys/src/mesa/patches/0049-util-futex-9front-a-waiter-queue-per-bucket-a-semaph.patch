From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: port <port@localhost>
Date: Sat, 21 Nov 2026 00:05:17 +0100
Subject: [PATCH] util/futex: 9front: a waiter queue per bucket, a semaphore
 per waiter, woken by address

One semaphore per bucket let a wake be taken by a waiter of another
address in the bucket, which found its value unchanged and waited
again, while the waiter it was meant for slept on: a lost wakeup
(servoshot hung after Complete, three threads in futex_wait with
Mesa's queues idle). Now each waiter queues itself, under the
bucket's lock, with a semaphore of its own, and futex_wake releases
only waiters of its address, as std's plan9 futex and APE's
condition variables do.
---
 src/util/futex.c | 123 ++++++++++++++++++++++++++++++++++++++---------
 1 file changed, 99 insertions(+), 24 deletions(-)

diff --git a/src/util/futex.c b/src/util/futex.c
index 863a9f2..8ae0f15 100644
--- a/src/util/futex.c
+++ b/src/util/futex.c
@@ -154,14 +154,23 @@ int futex_wait(uint32_t *addr, int32_t value, const struct timespec *timeout)
 #elif defined(__plan9__)
 
 /*
- * 9front: semaphores keyed by address (semacquire(2)), one per bucket
- * of addresses, with a count of the threads waiting on the bucket.
- * A waiter counts itself before it looks at the value, a waker changes
- * the value before it looks at the count: one of them sees the other.
- * Wakeups of other addresses in the bucket, or left over after a
- * timeout, are spurious ones, which futex callers expect.
+ * 9front: a queue of waiters per bucket of addresses, each waiter on a
+ * semaphore of its own (semacquire(2)), woken by address, as the plan9
+ * futex of Rust's std and the condition variables of APE's pthreads.
+ * A waiter looks at the value and queues itself under the bucket's lock,
+ * a waker changes the value before it takes the lock: the waker finds
+ * the waiter, or the waiter the new value.  A waiter's node is on its
+ * stack, which is shared memory (APE's and std's threads run on stacks
+ * from malloc or segments every proc has); a woken waiter is off the
+ * queue before its semaphore is released, and the waker does not touch
+ * it after that.
+ * A wake only reaches waiters of its address: with one semaphore per
+ * bucket a wake could be taken by a waiter of another address in the
+ * bucket, which found its value unchanged and waited again, while the
+ * one it was meant for slept on (a lost wakeup).
  */
 #include <errno.h>
+#include <sched.h>
 #include <stdint.h>
 #include <time.h>
 
@@ -169,9 +178,15 @@ extern int _SEMACQUIRE(int *, int);
 extern int _TSEMACQUIRE(int *, unsigned long);
 extern int _SEMRELEASE(int *, int);
 
-static struct {
+struct futex_waiter {
+   uint32_t *addr;
+   struct futex_waiter *next;
    int sem;
-   int waiters;
+};
+
+static struct {
+   int lock;
+   struct futex_waiter *head;
 } futex_buckets[256];
 
 static unsigned
@@ -180,43 +195,103 @@ futex_bucket(uint32_t *addr)
    return (uint32_t)((uintptr_t)addr >> 2) * 2654435761u >> 24;
 }
 
+static void
+futex_lock(int *l)
+{
+   while (__atomic_exchange_n(l, 1, __ATOMIC_ACQUIRE))
+      sched_yield();
+}
+
+static void
+futex_unlock(int *l)
+{
+   __atomic_store_n(l, 0, __ATOMIC_RELEASE);
+}
+
+/* off the bucket's queue; whether it was there (else a waker took it off
+ * and its release is due) */
+static int
+futex_unqueue(unsigned b, struct futex_waiter *w)
+{
+   struct futex_waiter **l;
+
+   for (l = &futex_buckets[b].head; *l != NULL; l = &(*l)->next) {
+      if (*l == w) {
+         *l = w->next;
+         return 1;
+      }
+   }
+   return 0;
+}
+
 int futex_wake(uint32_t *addr, int32_t count)
 {
    unsigned b = futex_bucket(addr);
-   int n = __atomic_load_n(&futex_buckets[b].waiters, __ATOMIC_SEQ_CST);
+   struct futex_waiter **l, *w;
+   int n = 0;
+
+   futex_lock(&futex_buckets[b].lock);
+   for (l = &futex_buckets[b].head; *l != NULL && n < count;) {
+      w = *l;
+      if (w->addr == addr) {
+         *l = w->next;
+         _SEMRELEASE(&w->sem, 1);   /* w may be gone after this */
+         n++;
+      } else
+         l = &w->next;
+   }
+   futex_unlock(&futex_buckets[b].lock);
+   return n;
+}
 
-   if (n > count)
-      n = count;
-   if (n > 0)
-      _SEMRELEASE(&futex_buckets[b].sem, n);
-   return 0;
+static int64_t
+futex_ms_left(const struct timespec *timeout)
+{
+   struct timespec now;
+
+   clock_gettime(CLOCK_MONOTONIC, &now);
+   return (int64_t)(timeout->tv_sec - now.tv_sec) * 1000 +
+          (timeout->tv_nsec - now.tv_nsec + 999999) / 1000000;
 }
 
 int futex_wait(uint32_t *addr, int32_t value, const struct timespec *timeout)
 {
    unsigned b = futex_bucket(addr);
-   struct timespec now;
+   struct futex_waiter w;
    int64_t ms;
-   int r;
+   int r, queued;
 
-   __atomic_add_fetch(&futex_buckets[b].waiters, 1, __ATOMIC_SEQ_CST);
+   futex_lock(&futex_buckets[b].lock);
    if (__atomic_load_n(addr, __ATOMIC_SEQ_CST) != (uint32_t)value) {
-      __atomic_sub_fetch(&futex_buckets[b].waiters, 1, __ATOMIC_SEQ_CST);
+      futex_unlock(&futex_buckets[b].lock);
       errno = EAGAIN;
       return -1;
    }
+   w.addr = addr;
+   w.sem = 0;
+   w.next = futex_buckets[b].head;
+   futex_buckets[b].head = &w;
+   futex_unlock(&futex_buckets[b].lock);
+
    if (timeout == NULL)
-      r = _SEMACQUIRE(&futex_buckets[b].sem, 1);
+      r = _SEMACQUIRE(&w.sem, 1);
    else {
       /* the timeout is absolute, on CLOCK_MONOTONIC (as FUTEX_WAIT_BITSET) */
-      clock_gettime(CLOCK_MONOTONIC, &now);
-      ms = (int64_t)(timeout->tv_sec - now.tv_sec) * 1000 +
-           (timeout->tv_nsec - now.tv_nsec) / 1000000;
-      r = ms > 0 ? _TSEMACQUIRE(&futex_buckets[b].sem, ms) : 0;
+      ms = futex_ms_left(timeout);
+      r = ms > 0 ? _TSEMACQUIRE(&w.sem, ms) : 0;
    }
-   __atomic_sub_fetch(&futex_buckets[b].waiters, 1, __ATOMIC_SEQ_CST);
    if (r > 0)
       return 0;
+   /* timed out or a note: off the queue, unless a waker took it off */
+   futex_lock(&futex_buckets[b].lock);
+   queued = futex_unqueue(b, &w);
+   futex_unlock(&futex_buckets[b].lock);
+   if (!queued) {
+      /* woken meanwhile: take the release, the node must stay until then */
+      while (_SEMACQUIRE(&w.sem, 1) < 0)
+         ;
+      return 0;
+   }
    errno = r == 0 ? ETIMEDOUT : EINTR;
    return -1;
 }
