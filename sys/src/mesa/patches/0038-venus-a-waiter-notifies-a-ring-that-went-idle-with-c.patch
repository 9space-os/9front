From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stefan Hertenberger <erde74@gmail.com>
Date: Sat, 7 Nov 2026 19:46:58 +0100
Subject: [PATCH] venus: a waiter notifies a ring that went idle with commands
 in it again (a lost notify left the ring idle and the waiter waiting for
 good)

The cause is not known (the renderer's side and both clocks checked: a
submit within the interval after a notify should find the renderer awake).
So a loss is said: a waiter that finds the ring idle with commands in it
and no notify for 50 ms writes one warning per ring ("venus: ring N idle
with commands ... notified again", with status, head, tail and the time
since the last notify); 9space's tests fail on it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/virtio/vulkan/vn_ring.c | 54 +++++++++++++++++++++++++++++++++++++
 1 file changed, 54 insertions(+)

diff --git a/src/virtio/vulkan/vn_ring.c b/src/virtio/vulkan/vn_ring.c
index 7a783b0..bb966cb 100644
--- a/src/virtio/vulkan/vn_ring.c
+++ b/src/virtio/vulkan/vn_ring.c
@@ -5,6 +5,8 @@
 
 #include "vn_ring.h"
 
+#include "util/log.h"
+
 #if !DETECT_OS_WINDOWS
 #include <sys/resource.h>
 #endif
@@ -66,6 +68,7 @@ struct vn_ring {
 
    int64_t last_notify;
    int64_t next_notify;
+   bool lost_said; /* a lost notify reported (vn_ring_kick_stalled) */
 };
 
 struct vn_ring_submit {
@@ -186,6 +189,53 @@ vn_ring_get_seqno_status(struct vn_ring *ring, uint32_t seqno)
    return vn_ring_ge_seqno(ring, vn_ring_load_head(ring), seqno);
 }
 
+/*
+ * A renderer idle with commands left in the ring missed its notify (each
+ * submit decides on one from the status it saw, and leaves out those within
+ * the interval after the last: the renderer may go idle sooner than that).
+ * A waiter notifies it again, once a millisecond at most; a notify more is
+ * harmless.
+ */
+static void
+vn_ring_kick_stalled(struct vn_ring *ring, int64_t *next)
+{
+   if (!(vn_ring_load_status(ring) & VK_RING_STATUS_IDLE_BIT_MESA))
+      return;
+   const uint32_t tail =
+      atomic_load_explicit(ring->shared.tail, memory_order_relaxed);
+   if (vn_ring_load_head(ring) == tail)
+      return;
+   const int64_t now = os_time_get_nano();
+   if (now < *next)
+      return;
+   *next = now + VN_RING_IDLE_TIMEOUT_NS;
+
+   /* A notify may still be on its way (a submit sent it moments ago); none
+    * for 50 ms, and the ring idle with commands in it, is one lost: say so,
+    * with what the next search needs (the cause is not known; tests fail
+    * on this line).
+    */
+   if (mtx_trylock(&ring->mutex) == thrd_success) {
+      const int64_t since = now - ring->last_notify;
+      if (since > 50 * 1000 * 1000 && !ring->lost_said) {
+         ring->lost_said = true;
+         mesa_logw("venus: ring %" PRIu64 " idle with commands (status %#x, "
+                   "head %u, tail %u), last notify %" PRId64 " us ago: "
+                   "notified again", ring->id,
+                   (unsigned)vn_ring_load_status(ring),
+                   vn_ring_load_head(ring), tail, since / 1000);
+      }
+      mtx_unlock(&ring->mutex);
+   }
+
+   uint32_t notify_ring_data[8];
+   struct vn_cs_encoder local_enc = VN_CS_ENCODER_INITIALIZER_LOCAL(
+      notify_ring_data, sizeof(notify_ring_data));
+   vn_encode_vkNotifyRingMESA(&local_enc, 0, ring->id, tail, 0);
+   vn_renderer_submit_simple(ring->instance->renderer, notify_ring_data,
+                             vn_cs_encoder_get_len(&local_enc));
+}
+
 void
 vn_ring_wait_seqno(struct vn_ring *ring, uint32_t seqno)
 {
@@ -196,11 +246,13 @@ vn_ring_wait_seqno(struct vn_ring *ring, uint32_t seqno)
                                           ? VN_RELAX_REASON_RING_SEQNO
                                           : VN_RELAX_REASON_TLS_RING_SEQNO;
    struct vn_relax_state relax_state = vn_relax_init(ring->instance, reason);
+   int64_t next_kick = os_time_get_nano() + VN_RING_IDLE_TIMEOUT_NS;
    do {
       if (vn_ring_get_seqno_status(ring, seqno)) {
          vn_relax_fini(&relax_state);
          return;
       }
+      vn_ring_kick_stalled(ring, &next_kick);
       vn_relax(&relax_state);
    } while (true);
 }
@@ -243,7 +295,9 @@ vn_ring_wait_space(struct vn_ring *ring, uint32_t size)
       /* see the reasoning in vn_ring_wait_seqno */
       struct vn_relax_state relax_state =
          vn_relax_init(ring->instance, VN_RELAX_REASON_RING_SPACE);
+      int64_t next_kick = os_time_get_nano() + VN_RING_IDLE_TIMEOUT_NS;
       do {
+         vn_ring_kick_stalled(ring, &next_kick);
          vn_relax(&relax_state);
          if (vn_ring_has_space(ring, size, &head)) {
             vn_relax_fini(&relax_state);
-- 
